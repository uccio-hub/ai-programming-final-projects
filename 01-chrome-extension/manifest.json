{
  "manifest_version": 3,
  "name": "Aurora Focus — Productivity Dashboard",
  "version": "4.1.0",
  "description": "A privacy-first productivity dashboard with daily goals, tasks, focus sessions, insights and ambient sound.",
  "permissions": ["alarms", "notifications", "storage"],
  "action": {
    "default_title": "Open Aurora Focus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
